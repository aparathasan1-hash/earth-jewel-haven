# ============================================================
# Earth Jewel Haven — Ortam Değişkenleri (örnek)
# Gerçek değerleri .env dosyasına koyun (.env gitignore'dadır).
# VITE_ önekli olanlar PUBLIC (istemciye gider); öneksizler SUNUCU-GİZLİ.
# ============================================================

# --- Supabase ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret      # server-only
SUPABASE_DB_URL=postgresql://user:pass@host:5432/db     # server-only (scripts/_runsql.mjs)

# --- Stripe (Gold üyelik) ---
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
VITE_STRIPE_GOLD_PRICE_ID=price_xxx

# --- Web Push (PWA bildirim, VAPID) ---
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key                 # server-only
VAPID_SUBJECT=mailto:you@example.com

# --- AI Asistan (Faz 1, opsiyonel) ---
ANTHROPIC_API_KEY=sk-ant-xxx                             # server-only; yoksa asistan skeleton modda

# --- Canlı Yayın (LiveKit, L1) ---
# LiveKit Cloud'dan alın: https://cloud.livekit.io  (ücretsiz test katmanı)
VITE_LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud        # public WebSocket URL
LIVEKIT_API_KEY=APIxxxxxxxx                              # server-only
LIVEKIT_API_SECRET=your-livekit-secret                  # server-only

# Stripe (server-only) — Gold abonelik
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_GOLD_PRICE_ID=price_xxx
